# Save a lot of typing for common commands
alias gs="git status"
alias gc="git commit"
alias gl="git log"
alias gad="git add"
alias gco="git checkout"
alias gsh="git stash"
alias gcp="git cherry-pick"
alias gre="git rebase"
alias gam="git commit --amend"
alias v="nvim"
alias vim="nvim"
alias vimm="\vim"
alias c="code"

# Save you from mistyping
alias sl=ls

# Overwrite existing commands for better defaults
alias mv="mv -i"           # -i prompts before overwrite
alias rm="rm -i"
alias mkdir="mkdir -p"     # -p make parent dirs as needed
alias df="df -h"           # -h prints human readable format

# eza: modern ls. GNU ls is still \ls
# No --icons: this terminal is not using a Nerd Font (p10k is powerline mode).
alias ls='eza --group-directories-first'
alias ll='eza -lh --git --group-directories-first'
alias tree='eza --tree --git-ignore'
alias la='eza -a --group-directories-first'
alias lla='eza -lah --git --group-directories-first'

function gp() {
	br=`git branch -vv | grep "*"`
	br1=${br#*origin/}
	br2=${br1%%:*}
	git push origin HEAD:${br2}
}

function gpp() {
	local target_commit="${1:-HEAD}"

	local br=`git branch -vv | grep "*"`
	local br1=${br#*origin/}
	local br2=${br1%%:*}

	git push origin ${target_commit}:refs/for/${br2}
}

alias fo='code $(fzf)'
